ANTHROPIC_API_KEY=sk-ant-xxxx

# Generator: the model whose outputs are being judged (already baked into test_suite.json
# as model_output, but kept here for scripts that generate fresh outputs to compare).
GENERATOR_MODEL=claude-sonnet-5

# Judge model. Deliberately configurable independently of the generator model.
# Mitigation for self-enhancement bias: use a DIFFERENT model family than the generator
# where possible (e.g. a different vendor's model). This repo only has Anthropic API
# access, so it defaults to a different Claude model tier (Opus judging Sonnet output)
# as a partial mitigation, and documents in README how to point this at a different
# vendor entirely (OpenAI/Gemini) via a one-line swap in judge/judge.py.
JUDGE_MODEL=claude-opus-4-8

PASS_THRESHOLD=3.5
LOG_LEVEL=INFO
